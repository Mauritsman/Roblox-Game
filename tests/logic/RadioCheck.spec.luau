--!nocheck
local RadioCheck = require("../../src/shared/Logic/RadioCheck")
local Config = require("../../src/shared/Config")

local RULES = RadioCheck.rulesFrom(Config)
local O = Config.Objectives

return function(t)
	t.test("rules come from Config", function()
		t.eq(RULES.delay, O.RadioDelay)
		t.eq(RULES.window, O.RadioWindow)
		t.eq(RULES.maxAnswers, O.RadioMaxAnswers)
		t.eq(RULES.missPoints, O.RadioMissPoints)
		t.eq(RULES.prankPoints, Config.Alarm.Points.PrankUsed)
	end)

	t.test("off (Easy): a bubble costs the usual prank points when it pops", function()
		local s = RadioCheck.new(false, RULES)
		t.eq(RadioCheck.bubbled(s, "G1", 0), nil)
		t.eq(RadioCheck.popped(s, "G1"), RULES.prankPoints)
	end)

	t.test("answered in time: no points at all", function()
		local s = RadioCheck.new(true, RULES)
		t.eq(RadioCheck.bubbled(s, "G1", 10), 10 + O.RadioDelay)
		t.eq(#RadioCheck.due(s, 13.9), 0)
		local due = RadioCheck.due(s, 14)
		t.eq(due[1], "G1")
		local result, points = RadioCheck.squawk(s, "G1", 14)
		t.eq(result, "Window")
		t.eq(points, 0)
		t.ok(RadioCheck.answer(s, "G1", 17))
		t.eq(s.answersLeft, O.RadioMaxAnswers - 1)
		t.eq(RadioCheck.popped(s, "G1"), 0)
		local expired, more = RadioCheck.expire(s, 100)
		t.eq(#expired, 0)
		t.eq(more, 0)
	end)

	t.test("missed: +40 when the window runs out, nothing extra when the bubble pops", function()
		local s = RadioCheck.new(true, RULES)
		RadioCheck.bubbled(s, "G1", 0)
		RadioCheck.squawk(s, "G1", O.RadioDelay)
		-- bubble pops (8 s) before the window ends (4 + 6 = 10 s)
		t.eq(RadioCheck.popped(s, "G1"), 0)
		t.ok(not RadioCheck.answer(s, "G1", O.RadioDelay + O.RadioWindow + 0.1), "too late")
		local expired, points = RadioCheck.expire(s, O.RadioDelay + O.RadioWindow + 0.1)
		t.eq(expired[1], "G1")
		t.eq(points, O.RadioMissPoints)
		t.eq(s.answersLeft, O.RadioMaxAnswers, "a miss uses no answer")
	end)

	t.test("max 2 answers per round, then every bubble costs +40", function()
		local s = RadioCheck.new(true, RULES)
		for index = 1, O.RadioMaxAnswers do
			local id = "G" .. index
			RadioCheck.bubbled(s, id, 0)
			RadioCheck.squawk(s, id, 4)
			t.ok(RadioCheck.answer(s, id, 5), id)
		end
		RadioCheck.bubbled(s, "G9", 20)
		local result, points = RadioCheck.squawk(s, "G9", 24)
		t.eq(result, "NoAnswers")
		t.eq(points, O.RadioMissPoints)
		t.ok(not RadioCheck.answer(s, "G9", 25))
		t.eq(RadioCheck.popped(s, "G9"), 0, "already paid")
	end)

	t.test("one check per guard at a time; a second bubble during it costs prank points", function()
		local s = RadioCheck.new(true, RULES)
		RadioCheck.bubbled(s, "G1", 0)
		t.eq(RadioCheck.bubbled(s, "G1", 1), nil)
		RadioCheck.squawk(s, "G1", 4)
		t.eq(RadioCheck.popped(s, "G1"), 0)
		t.eq(RadioCheck.popped(s, "G1"), RULES.prankPoints)
		RadioCheck.answer(s, "G1", 5)
		RadioCheck.forget(s, "G1")
		t.ok(RadioCheck.bubbled(s, "G1", 30) ~= nil, "new bubble, new check")
	end)

	t.test("cancel drops a check without points", function()
		local s = RadioCheck.new(true, RULES)
		RadioCheck.bubbled(s, "G1", 0)
		RadioCheck.cancel(s, "G1")
		t.ok(not RadioCheck.isOpen(s, "G1"))
		t.eq(#RadioCheck.due(s, 10), 0)
	end)
end
